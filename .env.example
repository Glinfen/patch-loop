# PatchLoop reads the API key from the process environment.
# Never commit a real key.
DEEPSEEK_API_KEY=

# Optional credentials referenced by custom provider profiles.
CHAT_API_KEY=
RESPONSES_API_KEY=

# Provider configuration is selected explicitly on the CLI. PatchLoop does not
# automatically trust a repository-local .env file.
# PATCHLOOP_PROVIDER_CONFIG=C:/path/to/providers.toml

# PGW-11 real acceptance is opt-in. Every model, endpoint, implementation
# version, and price lock must be explicit; blank values remain unverified.
PGW_DEEPSEEK_IMPLEMENTATION_VERSION=
PGW_DEEPSEEK_ENDPOINT=
PGW_DEEPSEEK_MODEL=
PGW_DEEPSEEK_PRICING_VERSION=
PGW_DEEPSEEK_INPUT_PER_MILLION=
PGW_DEEPSEEK_OUTPUT_PER_MILLION=

OPENAI_API_KEY=
PGW_OPENAI_IMPLEMENTATION_VERSION=
PGW_OPENAI_ENDPOINT=
PGW_OPENAI_MODEL=
PGW_OPENAI_PRICING_VERSION=
PGW_OPENAI_INPUT_PER_MILLION=
PGW_OPENAI_OUTPUT_PER_MILLION=

# The local service must already be running on a loopback address. PatchLoop
# does not download a model or start a background service for acceptance.
PGW_LOCAL_IMPLEMENTATION_VERSION=
PGW_LOCAL_ENDPOINT=
PGW_LOCAL_MODEL=
PGW_LOCAL_PRICING_VERSION=local-zero
PGW_LOCAL_INPUT_PER_MILLION=0
PGW_LOCAL_OUTPUT_PER_MILLION=0
