{
  "schema_version": "1.0",
  "cases": [
    {
      "id": "network-default",
      "action": "network",
      "arguments": {
        "url": "https://example.org/api"
      },
      "rule": null,
      "expected_decision": "require_approval"
    },
    {
      "id": "network-allow",
      "action": "network",
      "arguments": {
        "url": "https://example.org/api"
      },
      "rule": "allow",
      "expected_decision": "allow"
    },
    {
      "id": "network-deny",
      "action": "network",
      "arguments": {
        "url": "https://example.org/api"
      },
      "rule": "deny",
      "expected_decision": "deny"
    },
    {
      "id": "dependency_install-default",
      "action": "dependency_install",
      "arguments": {
        "manager": "pip",
        "name": "demo",
        "version": "1.2.3",
        "source": "https://pypi.org/simple"
      },
      "rule": null,
      "expected_decision": "require_approval"
    },
    {
      "id": "dependency_install-allow",
      "action": "dependency_install",
      "arguments": {
        "manager": "pip",
        "name": "demo",
        "version": "1.2.3",
        "source": "https://pypi.org/simple"
      },
      "rule": "allow",
      "expected_decision": "allow"
    },
    {
      "id": "dependency_install-deny",
      "action": "dependency_install",
